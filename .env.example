# Optional for foundation tests. Copy to .env and fill in locally for later live analysis.
OPENAI_API_KEY=
OPENAI_MODEL=
# Empty uses the provider client's default endpoint; no client is implemented in T01.
OPENAI_BASE_URL=
AFS_REQUEST_TIMEOUT_SECONDS=60
AFS_MAX_RETRIES=2
AFS_RETRIEVAL_K=8
# Paths are resolved against the repository root, not the current terminal directory.
AFS_SOURCE_DIR=materials
AFS_INDEX_DIR=data/index
# Required when implementing T04; no embedding provider/model is assumed.
AFS_EMBEDDING_MODEL=
